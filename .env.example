# Copy to .env and fill in. Never commit .env.

# --- LLM (Gemini, free tier) ---
GEMINI_API_KEY=
# Verify these IDs with scripts/check_keys.py before relying on them.
MODEL_MAIN=gemini-3.8-flash
MODEL_FAST=gemini-3.5-flash-lite

# --- Speech (Sarvam AI hackathon credits) ---
SARVAM_API_KEY=
# Verified 31 Oct 2026. Sarvam's TTS accepts only 'bulbul:v3' or 'bulbul:v4-flash'.
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_STT_MODEL=saaras:v4

# --- WhatsApp (Meta Cloud API test number) ---
META_WA_TOKEN=
META_PHONE_ID=
META_VERIFY_TOKEN=

# --- Databases (docker compose services) ---
MOCK_PAYTM_DATABASE_URL=postgresql+psycopg://sahayak:sahayak@localhost:5432/mock_paytm
BACKEND_DATABASE_URL=postgresql+psycopg://sahayak:sahayak@localhost:5432/sahayak
REDIS_URL=redis://localhost:6379/0

# --- Mock Paytm behaviour ---
MOCK_PAYTM_BASE_URL=http://localhost:8001
# Seconds a re-triggered settlement stays PROCESSING before it is CREDITED.
SETTLEMENT_PROCESSING_SECONDS=10
# A device with no heartbeat for this long is reported OFFLINE.
HEARTBEAT_TIMEOUT_SECONDS=300
